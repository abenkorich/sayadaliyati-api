# Run pnpm setup:local to create an ignored .env with fresh local credentials.
# These placeholders are not usable credentials. Never use this setup in production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
AUTH_SECRET=replace-with-64-lowercase-hex-characters
REDIS_PORT=56380
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL=redis://:replace-with-local-redis-password@127.0.0.1:56380/0
TEST_REDIS_URL=redis://:replace-with-local-redis-password@127.0.0.1:56380/1
POSTGRES_PORT=55433
POSTGRES_PASSWORD=replace-with-local-owner-password
APP_DB_PASSWORD=replace-with-local-app-password
DATABASE_URL=postgresql://saydaliyati_app:replace-with-local-app-password@127.0.0.1:55433/saydaliyati
MIGRATION_DATABASE_URL=postgresql://saydaliyati_owner:replace-with-local-owner-password@127.0.0.1:55433/saydaliyati
TEST_DATABASE_URL=postgresql://saydaliyati_owner:replace-with-local-owner-password@127.0.0.1:55433/saydaliyati_test
TEST_RUNTIME_DATABASE_URL=postgresql://saydaliyati_app:replace-with-local-app-password@127.0.0.1:55433/saydaliyati_test

# Optional private document storage (pnpm setup:local generates local values).
# Never use the local development root credentials in production.
# DOCUMENT_STORAGE_ENDPOINT=http://127.0.0.1:59001
# DOCUMENT_STORAGE_BUCKET=saydaliyati-documents
# DOCUMENT_STORAGE_REGION=us-east-1
# DOCUMENT_STORAGE_ACCESS_KEY=saydaliyati-local
# DOCUMENT_STORAGE_SECRET_KEY=<random-local-secret>
# MINIO_ROOT_USER=saydaliyati-local
# MINIO_ROOT_PASSWORD=<same-random-local-secret>
# MINIO_PORT=59001

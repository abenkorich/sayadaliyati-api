# Reference only: configure these variables in your server/deployment environment.
# No .env.docker file is required or automatically loaded.
# Container localhost refers to the container, not your VPS or another service.
DATABASE_URL=postgresql://app:replace-me@your-postgres-host:5432/saydaliyati
REDIS_URL=redis://:replace-me@your-redis-host:6379/0
AUTH_SECRET=replace-with-64-lowercase-hex-characters
# Document uploads still use private S3-compatible storage, not dev_data.
# DOCUMENT_STORAGE_ENDPOINT=https://your-private-storage-endpoint
# DOCUMENT_STORAGE_BUCKET=saydaliyati-documents
# DOCUMENT_STORAGE_REGION=us-east-1
# DOCUMENT_STORAGE_ACCESS_KEY=replace-me
# DOCUMENT_STORAGE_SECRET_KEY=replace-me
